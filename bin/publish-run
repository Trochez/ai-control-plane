#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.config/ai-control-plane/config.env"

RUN_ID="${1:?run id required}"

RUN_DIR="$CONTROL_ROOT/workflows/$WORKFLOW_ID/runs/$RUN_ID"
STATE_FILE="$CONTROL_ROOT/workflows/$WORKFLOW_ID/state/current.json"

test -f "$RUN_DIR/RESULT.md"
test -f "$RUN_DIR/evidence.json"
test -f "$RUN_DIR/operator-exit-code.txt"

STATUS="$(
python3 - "$STATE_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    print(json.load(f)["status"])
PY
)"

[[ "$STATUS" == "REVIEW_READY" ]] || {
    echo "NOT_REVIEW_READY: $STATUS" >&2
    exit 1
}

cd "$CONTROL_ROOT"

git add "workflows/$WORKFLOW_ID"

if git diff --cached --quiet; then
    echo "NO_CONTROL_PLANE_CHANGES"
else
    git commit \
      -m "evidence: record $RUN_ID OpenCode execution"
fi

git push

echo "RUN_PUBLISHED=$RUN_ID"
