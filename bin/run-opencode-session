#!/usr/bin/env bash
set -euo pipefail

CONFIG="$HOME/.config/ai-control-plane/config.env"

test -f "$CONFIG" || {
    echo "Missing config: $CONFIG" >&2
    exit 1
}

source "$CONFIG"

PLAN_PATH="${1:?PLAN path required}"
RUN_DIR="${2:?RUN directory required}"
PLAN_ID="${3:?PLAN ID required}"
RUN_ID="${4:?RUN ID required}"

test -f "$PLAN_PATH" || {
    echo "PLAN not found: $PLAN_PATH" >&2
    exit 1
}

test -d "$RUN_DIR" || {
    echo "RUN directory not found: $RUN_DIR" >&2
    exit 1
}

MAX_ATTEMPTS="${OPENCODE_MAX_ATTEMPTS:-2}"

BOOTSTRAP_PROMPT="$(cat <<PROMPT
You are the OpenCode Local Operator.

Workflow:
$WORKFLOW_ID

Plan:
$PLAN_ID

Run:
$RUN_ID

Target repository:
$TARGET_REPO

Authoritative PLAN:
$PLAN_PATH

Assigned evidence directory:
$RUN_DIR

This is a NEW workflow session.

Do not rely on assumptions from previous OpenCode sessions.

Before modifying anything:

1. read the complete authoritative PLAN;
2. read applicable persistent/project instructions;
3. verify repository identity;
4. verify target branch;
5. verify current HEAD SHA;
6. verify expected_base_sha;
7. inspect the working tree;
8. preserve unrelated changes;
9. verify mandatory prerequisites.

If a mandatory precondition fails, produce BLOCKED evidence.

Otherwise execute the PLAN completely.

At completion:

1. create $RUN_DIR/RESULT.md;
2. create $RUN_DIR/evidence.json;
3. create all supporting evidence required by the PLAN;
4. do not modify workflow lifecycle state;
5. do not create the next authoritative PLAN;
6. lifecycle transitions belong to the local orchestrator;
7. planning/review belongs to ChatGPT.
PROMPT
)"

RECOVERY_PROMPT="$(cat <<PROMPT
You are the OpenCode Local Operator recovery agent.

Workflow:
$WORKFLOW_ID

Plan:
$PLAN_ID

Run:
$RUN_ID

Target repository:
$TARGET_REPO

Authoritative PLAN:
$PLAN_PATH

Assigned evidence directory:
$RUN_DIR

This is a recovery attempt for run $RUN_ID. A previous OpenCode attempt exited 0 but the mandatory evidence contract was incomplete or invalid. Read the PLAN at $PLAN_PATH and the prior attempt log at $RUN_DIR/operator-attempt-1.log, then physically create and validate the missing evidence artifacts:

- $RUN_DIR/RESULT.md
- $RUN_DIR/evidence.json
- $RUN_DIR/git-status-after.txt
- $RUN_DIR/head-sha-after.txt

Also validate evidence.json with: python3 -m json.tool $RUN_DIR/evidence.json

Do not claim completion until all four core artifacts exist and evidence.json is valid JSON.
PROMPT
)"

OPENCODE_MODEL_ARGS=()

if [[ -n "${OPENCODE_MODEL:-}" ]]; then
    OPENCODE_MODEL_ARGS+=(
        --model "$OPENCODE_MODEL"
    )
fi

if [[ -n "${OPENCODE_VARIANT:-}" ]]; then
    OPENCODE_MODEL_ARGS+=(
        --variant "$OPENCODE_VARIANT"
    )
fi

cd "$TARGET_REPO"

echo "OPENCODE_MODE=${OPENCODE_MODE:-run}"
echo "OPENCODE_MODEL=${OPENCODE_MODEL:-default}"
echo "OPENCODE_AGENT=$OPENCODE_AGENT"
echo "PLAN_ID=$PLAN_ID"
echo "RUN_ID=$RUN_ID"
echo "MAX_ATTEMPTS=$MAX_ATTEMPTS"

set +e

ATTEMPT=0
EVIDENCE_OK=false

while [[ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]]; do
    ATTEMPT=$((ATTEMPT + 1))

    ATTEMPT_LOG="$RUN_DIR/operator-attempt-${ATTEMPT}.log"
    ATTEMPT_EXIT_FILE="$RUN_DIR/operator-attempt-${ATTEMPT}-exit-code.txt"

    if [[ "$ATTEMPT" -eq 1 ]]; then
        PROMPT="$BOOTSTRAP_PROMPT"
    else
        PROMPT="$RECOVERY_PROMPT"
    fi

    echo "=== ATTEMPT $ATTEMPT of $MAX_ATTEMPTS ==="

    opencode run \
        --agent "$OPENCODE_AGENT" \
        "${OPENCODE_MODEL_ARGS[@]}" \
        --dir "$TARGET_REPO" \
        --format default \
        "$PROMPT" \
        2>&1 | tee "$ATTEMPT_LOG"

    OPENCODE_EXIT=${PIPESTATUS[0]}

    printf '%s\n' "$OPENCODE_EXIT" > "$ATTEMPT_EXIT_FILE"

    if [[ "$OPENCODE_EXIT" -eq 0 ]]; then
        MISSING=()

        for artifact in RESULT.md evidence.json git-status-after.txt head-sha-after.txt; do
            test -f "$RUN_DIR/$artifact" || MISSING+=("$artifact")
        done

        if [[ ${#MISSING[@]} -gt 0 ]]; then
            echo "EVIDENCE_INCOMPLETE: missing ${MISSING[*]}" >&2
            EVIDENCE_OK=false
        elif ! python3 -m json.tool "$RUN_DIR/evidence.json" >/dev/null 2>&1; then
            echo "EVIDENCE_INVALID: evidence.json fails JSON validation" >&2
            EVIDENCE_OK=false
        else
            EVIDENCE_OK=true
            break
        fi
    else
        echo "OPENCODE_EXIT_CODE=$OPENCODE_EXIT" >&2
        echo "Run remains RUNNING for inspection." >&2

        printf '%s\n' "$OPENCODE_EXIT" > "$RUN_DIR/operator-exit-code.txt"
        exit "$OPENCODE_EXIT"
    fi
done

set -e

if [[ "$EVIDENCE_OK" != "true" ]]; then
    echo "ATTEMPTS_EXHAUSTED: evidence contract still incomplete after $MAX_ATTEMPTS attempts" >&2
    exit 1
fi

# Preserve operator.log as canonical first-attempt log for compatibility.
if [[ -f "$RUN_DIR/operator-attempt-1.log" ]] && [[ ! -f "$RUN_DIR/operator.log" ]]; then
    cp "$RUN_DIR/operator-attempt-1.log" "$RUN_DIR/operator.log"
fi
if [[ -f "$RUN_DIR/operator-attempt-1-exit-code.txt" ]] && [[ ! -f "$RUN_DIR/operator-exit-code.txt" ]]; then
    cp "$RUN_DIR/operator-attempt-1-exit-code.txt" "$RUN_DIR/operator-exit-code.txt"
fi

"$CONTROL_ROOT/bin/complete-run" \
    "$PLAN_ID" \
    "$RUN_ID"

echo "OPERATOR_RUN_COMPLETE=$RUN_ID"

"$CONTROL_ROOT/bin/publish-run" "$RUN_ID"
