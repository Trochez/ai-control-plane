#!/usr/bin/env bash
set -euo pipefail
PLAN=${1:-}
[[ -n "$PLAN" && -f "$PLAN" ]] || { echo "Usage: $0 /path/to/PLAN.md" >&2; exit 2; }
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for c in python3 node git; do command -v "$c" >/dev/null || { echo "PREFLIGHT=FAIL missing=$c"; exit 10; }; done
python3 - "$ROOT" <<'PY'
import importlib.util, pathlib, sys
root=pathlib.Path(sys.argv[1])
spec=importlib.util.spec_from_file_location('ai_loop',root/'ai-loopd-v3.py')
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
assert m.VERSION=='4.7.0',m.VERSION
print('PREFLIGHT_VERSION=PASS version='+m.VERSION)
PY
[[ -x "$ROOT/bin/verify-v4.5-local" ]] || { echo 'PREFLIGHT=FAIL verify-v4.5-local'; exit 11; }
[[ -f "$PLAN" ]] || { echo 'PREFLIGHT=FAIL plan'; exit 12; }
if [[ "${AI_LOOP_BROWSER_MODE:-headed_display}" == "headed_display" && -z "${DISPLAY:-}" ]]; then
  echo 'PREFLIGHT=FAIL headed_display_requires_DISPLAY'; exit 13
fi
echo "PREFLIGHT=PASS plan=$(realpath "$PLAN") browser_mode=${AI_LOOP_BROWSER_MODE:-headed_display}"
