#!/usr/bin/env bash
set -euo pipefail
MANIFEST=${2:-}
[[ "${1:-}" == "--manifest" && -f "$MANIFEST" ]] || { echo 'Usage: verify-acceptance-v4.5 --manifest acceptance-manifest.json' >&2; exit 2; }
python3 - "$MANIFEST" <<'PY'
import json, pathlib, sys
p=pathlib.Path(sys.argv[1]); obj=json.loads(p.read_text())
missing=[k for k in ('schema_version','run_kind','run_id','iterations','observed_at') if k not in obj]
if missing: print('ACCEPTANCE=INCOMPLETE_INTERNAL missing='+','.join(missing)); raise SystemExit(21)
if obj.get('run_kind') not in {'read_only_probe','implementation'} or not isinstance(obj.get('iterations'),list) or not obj['iterations']:
    print('ACCEPTANCE=INCOMPLETE_INTERNAL shape_invalid'); raise SystemExit(21)
for i,item in enumerate(obj['iterations']):
    if not isinstance(item,dict) or not item.get('chat_url') or not item.get('delivery_id') or not item.get('response_sha256'):
        print(f'ACCEPTANCE=INCOMPLETE_INTERNAL iteration={i} identity_or_response_missing'); raise SystemExit(21)
    if obj['run_kind']=='implementation' and not item.get('candidate_sha'):
        print(f'ACCEPTANCE=INCOMPLETE_INTERNAL iteration={i} candidate_missing'); raise SystemExit(21)
print('ACCEPTANCE=PASS manifest='+str(p)+' run_kind='+obj['run_kind']+' iterations='+str(len(obj['iterations'])))
PY
